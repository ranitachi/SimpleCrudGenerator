{
  "name": "ranitachi/simple-crud-generator",
  "description": "A simple CRUD generator package for Laravel",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Fachran Nazarullah",
      "email": "fachran@example.com"
    }
  ],
  "require": {
    "php": "^8.2", 
    "illuminate/support": "^8.0|^9.0|^10.0|^11.0",
    "illuminate/console": "^8.0|^9.0|^10.0|^11.0",
    "illuminate/filesystem": "^8.0|^9.0|^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Fcn\\SimpleCrudGenerator\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Fcn\\SimpleCrudGenerator\\SimpleCrudGeneratorServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
