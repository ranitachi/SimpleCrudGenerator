<?php

namespace App\Services;

use App\Models\{{model}};
use Illuminate\Http\Request;
use Illuminate\Support\Str;
use Yajra\DataTables\Facades\DataTables;

class {{model}}Service
{
    protected $model;

    public function __construct({{model}} $model)
    {
        $this->model = $model;
    }

    public function find($id)
    {
        return $this->model->findOrFail($id);
    }

    public function getQuery(Request $request)
    {
        $query = $this->model->query();

        if ($filters = $request->input('filter')) {
            foreach ($filters as $field => $value) {
                if (!empty($value)) {
                    $query->where($field, 'like', "%$value%");
                }
            }
        }

        return $query;
    }

    public function getDatatableResponse(Request $request)
    {
        $query = $this->getQuery($request);

        $datatable = DataTables::of($query)->addIndexColumn();

        // === Tambahkan kolom FLAG kalau ada ===
        $flagFields = ['flag', 'status_aktif', 'status', 'flag_aktif'];
        foreach ($flagFields as $flagField) {
            if (isset($query->first()->{$flagField})) {
                $datatable->addColumn($flagField, function ($row) use ($flagField) {
                    return $row->{$flagField}
                        ? '<span class="badge bg-success">Aktif</span>'
                        : '<span class="badge bg-secondary">Nonaktif</span>';
                });
                $rawColumns[] = $flagField;
                break;
            }
        }

        // === Tambahkan kolom media (preview image) kalau ada ===
        $mediaFields = ['preview', 'foto', 'icon', 'image', 'images', 'photo', 'picture'];
        foreach ($mediaFields as $mediaField) {
            if (isset($query->first()->{$mediaField})) {
                $datatable->addColumn($mediaField, function ($row) use ($mediaField) {
                    $src = asset('storage/' . $row->{$mediaField});
                    return '<img src="' . $src . '" alt="' . $mediaField . '" style="max-height: 60px; max-width: 100px;">';
                });
                $rawColumns[] = $mediaField;
                break;
            }
        }

        // === Set rawColumns kalau ada ===
        if (!empty($rawColumns)) {
            $datatable->rawColumns($rawColumns);
        }

        return $datatable->make(true);
    }



    public function getDatatableColumns(): array
    {
        return {{datatable}};
    }

    public function getFields(?{{model}} $data = null): array
    {
        return {{fields}};
    }

    public function store(array $data)
    {
        return $this->model->create($data);
    }

    public function update({{model}} $model, array $data)
    {
        return $model->update($data);
    }

    public function delete({{model}} $model)
    {
        return $model->delete();
    }
}
