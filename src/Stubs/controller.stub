<?php

namespace App\Http\Controllers;

use App\Http\Controllers\Controller;
use App\Services\{{model}}Service;
use App\Http\Requests\{{model}}Request;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Exception;

class {{model}}Controller extends Controller
{
    protected $service;

    public function __construct({{model}}Service $service)
    {
        $this->service = $service;
    }

    public function index()
    {
        $columns = $this->service->getDatatableColumns();
        $datatableBasePath  = '/admin/{{table}}';
        return view('vendor.simple-crud.{{table}}.index', compact('columns'));
    }

    public function datatable(Request $request)
    {
        return $this->service->getDatatableResponse($request);
    }

    public function create()
    {
        $fields = $this->service->getFields();
        return view('vendor.simple-crud.{{table}}.create', compact('fields'));
    }

    public function store({{model}}Request $request)
    {
        DB::beginTransaction();
        try {
            $this->service->store($request->validated());
            DB::commit();
            return redirect()->route('{{table}}.index')->with('success', 'Data berhasil disimpan');
        } catch (Exception $e) {
            DB::rollBack();
            return back()->withErrors(['error' => $e->getMessage()]);
        }
    }

    public function edit($id)
    {
        $data = $this->service->find($id);
        $fields = $this->service->getFields($data);
        return view('vendor.simple-crud.{{table}}.edit', compact('fields', 'data'));
    }

    public function update({{model}}Request $request, $id)
    {
        DB::beginTransaction();
        try {
            $data = $this->service->find($id);
            $this->service->update($data, $request->validated());
            DB::commit();
            return redirect()->route('{{table}}.index')->with('success', 'Data berhasil diperbarui');
        } catch (Exception $e) {
            DB::rollBack();
            return back()->withErrors(['error' => $e->getMessage()]);
        }
    }

    public function destroy($id)
    {
        DB::beginTransaction();
        try {
            $data = $this->service->find($id);
            $this->service->delete($data);
            DB::commit();
            return redirect()->route('{{table}}.index')->with('success', 'Data berhasil dihapus');
        } catch (Exception $e) {
            DB::rollBack();
            return back()->withErrors(['error' => $e->getMessage()]);
        }
    }
}
