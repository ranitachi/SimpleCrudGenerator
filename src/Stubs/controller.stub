<?php

namespace App\Http\Controllers;

use App\Http\Controllers\Controller;
use App\Services\{{model}}Service;
use App\Http\Requests\{{model}}Request;
use Illuminate\Support\Facades\DB;
use Exception;

class {{model}}Controller extends Controller
{
    protected $service;

    public function __construct({{model}}Service $service)
    {
        $this->service = $service;
    }

    public function index()
    {
        return response()->json($this->service->fetch());
    }

    public function show($uuid)
    {
        $record = $this->service->get($uuid);
        return $record ? response()->json($record) : response()->json(['message' => 'Not found'], 404);
    }

    public function store({{model}}Request $request)
    {
        DB::beginTransaction();
        try {
            $this->service->store($request->validated());
            DB::commit();
            return response()->json(['message' => '{{model}} created successfully'], 201);
        } catch (Exception $e) {
            DB::rollBack();
            return response()->json(['error' => $e->getMessage()], 500);
        }
    }

    public function update({{model}}Request $request, $uuid)
    {
        DB::beginTransaction();
        try {
            $record = $this->service->get($uuid);
            if (!$record) return response()->json(['message' => 'Not found'], 404);
            $this->service->update($record, $request->validated());
            DB::commit();
            return response()->json(['message' => '{{model}} updated']);
        } catch (Exception $e) {
            DB::rollBack();
            return response()->json(['error' => $e->getMessage()], 500);
        }
    }

    public function destroy($uuid)
    {
        DB::beginTransaction();
        try {
            $record = $this->service->get($uuid);
            if (!$record) return response()->json(['message' => 'Not found'], 404);
            $this->service->delete($record);
            DB::commit();
            return response()->json(['message' => 'Deleted successfully']);
        } catch (Exception $e) {
            DB::rollBack();
            return response()->json(['error' => $e->getMessage()], 500);
        }
    }
}